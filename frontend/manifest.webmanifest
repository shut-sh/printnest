{
  "name": "PrintNest",
  "short_name": "PrintNest",
  "description": "Simple, private, self-hosted printing.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1a1a2e",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": ["application/pdf", "image/jpeg", "image/png", "image/webp", "image/heic", "image/heif"] }] }
  }
}
