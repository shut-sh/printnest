BIND=127.0.0.1
PORT=8080
DATA_DIR=/var/lib/printnest
FRONTEND_DIR=/opt/printnest/frontend/dist
CUPS_HOST=localhost
CUPS_PORT=631
CUPS_USER=printnest
IPP_TIMEOUT_SECONDS=25
FILE_RETENTION_MINUTES=30
MAX_UPLOAD_MB=50
PRINTNEST_PASSWORD=change-me-on-first-boot
# The installer writes bounded CUPS retries into /etc/cups/cupsd.conf
# (JobRetryLimit 3, JobRetryInterval 30).
